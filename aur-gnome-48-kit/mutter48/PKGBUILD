prepare() {
  local -a pango_cflags
  read -ra pango_cflags <<< "$(pkg-config --cflags pango)"
  if printf '#include <pango/pango.h>\nvoid probe(void) { g_autoptr(PangoRenderer) renderer = NULL; }\n' | cc -x c -fsyntax-only "${pango_cflags[@]}" - 2>/dev/null; then
    sed -i '/^G_DEFINE_AUTOPTR_CLEANUP_FUNC (PangoRenderer, g_object_unref)$/d' mutter/clutter/clutter/pango/clutter-pango-private.h
  fi
}

build() {
  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=' -Wl,-Bsymbolic-functions'
  export MESON_PACKAGE_CACHE_DIR="$srcdir"
  arch-meson mutter build -D docs=false -D egl_device=true -D installed_tests=false -D tests=disabled -D wayland_eglstream=true --wrap-mode=nofallback
  meson compile -C build -j "${GNOME48_JOBS:-2}"
}

package() {
  meson install -C build --destdir "$pkgdir"
}