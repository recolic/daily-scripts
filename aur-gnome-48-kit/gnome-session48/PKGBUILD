pkgname=gnome-session48
pkgver=48.0
pkgrel=4
pkgdesc='GNOME 48 session handler for the legacy Shell startup protocol'
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/gnome-session'
license=(GPL-2.0-or-later)
depends=(bash dconf gcc-libs glib2 glibc gnome-desktop gnome-keyring gsettings-desktop-schemas gtk3 json-glib libepoxy libgl libice libsm libx11 libxcomposite libxtst systemd systemd-libs xdg-desktop-portal-gnome)
makedepends=(git glib2-devel mesa meson python xtrans)
provides=("gnome-session=$pkgver")
conflicts=(gnome-session)
source=("git+$url.git#tag=$pkgver")
b2sums=('e7364791aae9fe2be01dc907218b5208eb7cb7aa27e18f34b41502459aab1333327ba0c82511d0021ee20758eb3dace4145be2a6776ee2cc90c8b04d4bcb738d')

prepare() {
  sed -i '/^required_components = {/,/^}/c\required_components = {\n  desktop_plain: [],\n}' gnome-session/data/meson.build
}

build() {
  arch-meson gnome-session build -D docbook=false -D man=false --wrap-mode=nofallback
  meson compile -C build -j "${GNOME48_JOBS:-2}"
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}