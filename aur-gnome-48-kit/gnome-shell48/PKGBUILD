prepare() {
  ln -sfn libgnome-volume-control gvc
  git -C gnome-shell apply "$srcdir/libical4.patch"
  if pkg-config --atleast-version=1.85.1 gjs-1.0; then git -C gnome-shell apply "$srcdir/gjs185.patch"; fi
}

build() {
  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=' -Wl,-Bsymbolic-functions'
  export MESON_PACKAGE_CACHE_DIR="$srcdir"
  arch-meson gnome-shell build -D gtk_doc=false -D tests=false --wrap-mode=nofallback
  meson compile -C build -j "${GNOME48_JOBS:-2}"
}

_runtime_dependencies() {
  if pkg-config --atleast-version=1.85.1 gjs-1.0; then depends+=('gjs>=2:1.85.1' 'glib2>=2.85.1'); else depends+=('gjs<2:1.85.1'); fi
}

package() {
  _runtime_dependencies
  meson install -C build --destdir "$pkgdir"
}