pkgname=gdm48
pkgver=48.0
pkgrel=3
pkgdesc='GNOME 48 display manager and login screen'
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/gdm'
license=(GPL-2.0-or-later)
depends=(accountsservice audit bash gcc-libs gdk-pixbuf2 glib2 glibc 'gnome-session>=48' 'gnome-session<49' 'gnome-shell>=1:48' 'gnome-shell<1:49' gtk3 json-glib keyutils libcanberra libgdm libgudev libx11 libxau libxcb libxdmcp pam systemd systemd-libs upower)
makedepends=(dconf docbook-xsl git glib2-devel gobject-introspection meson plymouth yelp-tools xorg-server xorg-xhost xorg-xrdb)
checkdepends=(check)
optdepends=('fprintd: Fingerprint authentication' 'xorg-server: X session support' 'xorg-xhost: X session support' 'xorg-xrdb: X session support')
provides=("gdm=$pkgver")
conflicts=(gdm)
install=gdm48.install
backup=(etc/gdm/PostSession/Default etc/gdm/PreSession/Default etc/gdm/Xsession etc/gdm/custom.conf etc/pam.d/gdm-autologin etc/pam.d/gdm-fingerprint etc/pam.d/gdm-launch-environment etc/pam.d/gdm-password etc/pam.d/gdm-smartcard)
_arch_source='https://gitlab.archlinux.org/archlinux/packaging/packages/gdm/-/raw/48.0-2'
source=("git+$url.git#tag=$pkgver" "$_arch_source/0001-Xsession-Don-t-start-ssh-agent-by-default.patch" "$_arch_source/0002-gdm-settings-utils-rename-variable-to-fix-build-with.patch")
b2sums=('d08d2137f630999b2f36bd8b798805e145fd7350fc4a092056cfdddd2170ae57b3b17a3a8f44f4c08a7e527a165fdce0dfa7a934188bc487d2a6d5bd848497b0'
  'f7e868fdd7cc121433de1572583eb728f4d186cd4f52c6d6c8f2ccf4a3cf781144ff71f704f13571ddb97a1ff4ec55cfa3df25d38737ad19da21e84ddc2d3ee4'
  'c704138b5f6be3ebb7d6606a78d2008cff1116bb033a0ba531b21e2b0cfc7c631c7c0720aa35694c1f0e36d9d6b81e9186f8e3f9fa12e885fe522cfcd2d98d63')

prepare() {
  cd gdm
  git apply ../0001-Xsession-Don-t-start-ssh-agent-by-default.patch
  git apply ../0002-gdm-settings-utils-rename-variable-to-fix-build-with.patch
}

build() {
  arch-meson gdm build -D dbus-sys=/usr/share/dbus-1/system.d -D default-pam-config=arch -D default-path=/usr/local/bin:/usr/local/sbin:/usr/bin -D gdm-xsession=true -D ipv6=true -D run-dir=/run/gdm -D selinux=disabled --wrap-mode=nofallback
  meson compile -C build -j "${GNOME48_JOBS:-2}"
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  cd "$pkgdir"
  install -d -o 0 -g 0 -m 0755 var var/lib
  install -d -o 120 -g 120 -m 1770 var/lib/gdm
  install -d -o 120 -g 120 -m 0700 var/lib/gdm/.config var/lib/gdm/.config/pulse
  printf '%s\n' load-module\ module-{device-restore,card-restore,udev-detect,native-protocol-unix,default-device-restore,always-sink,intended-roles,suspend-on-idle,systemd-login,position-event-sounds} > var/lib/gdm/.config/pulse/default.pa
  chmod 644 var/lib/gdm/.config/pulse/default.pa
  chown 120:120 var/lib/gdm/.config/pulse/default.pa
  install -Dm644 /dev/stdin usr/lib/sysusers.d/gdm.conf <<'END'
g gdm 120 -
u gdm 120 "Gnome Display Manager" /var/lib/gdm
END
  rm -r usr/include usr/lib/girepository-1.0 usr/lib/libgdm* usr/lib/pkgconfig usr/share/gir-1.0 usr/share/glib-2.0
}